# Configuration du déploiement PRODUCTION (docker-compose.prod.yml).
# Copier ce fichier en .env.prod (gitignoré) et renseigner les 4 variables.
#
#   cp .env.prod.example .env.prod && $EDITOR .env.prod

# Nom de domaine public pointant (enregistrement DNS A) vers l'IP du VPS.
# Grafana est servi sur le sous-domaine grafana.$DOMAIN (prévoir l'enregistrement DNS).
DOMAIN=mecha.gousnowweb.com

# E-mail pour Let's Encrypt (notifications d'expiration de certificat) — à renseigner.
ACME_EMAIL=ton-email@exemple.com

# Mot de passe du compte admin Grafana (https://grafana.$DOMAIN) — à renseigner.
GRAFANA_ADMIN_PASSWORD=change-moi

# Identifiants basic-auth du dashboard, au format htpasswd bcrypt.
# IMPORTANT : dans ce fichier, DOUBLER chaque « $ » du hash en « $$ »
# (sinon docker compose l'interprète comme une variable et casse l'auth).
#
# Générer le hash (remplace « admin » par ton utilisateur) :
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'MonMotDePasse'
# puis coller le résultat ci-dessous EN DOUBLANT les « $ ».
# Exemple (hash fictif) : admin:$$2y$$05$$abcdefghijklmnopqrstuv
BASIC_AUTH=admin:$$2y$$05$$REMPLACER_PAR_TON_HASH_AVEC_DOLLARS_DOUBLES
