# API de maintenance prédictive MECHA (FastAPI + LSTM).
# Image auto-portée : embarque les 3 artefacts d'inférence (scaler + 2 têtes LSTM, ~300 Ko,
# versionnés) — les modèles RF/XGB volumineux ne sont pas chargés par l'API. torch est
# installé en variante CPU (le GPU cu128 du dev n'est pas requis pour servir).
FROM python:3.12-slim

WORKDIR /app

# curl pour le healthcheck docker-compose
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# torch CPU d'abord (index dédié), puis les dépendances runtime de l'API
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir \
        "fastapi>=0.139.0" "uvicorn[standard]>=0.50.0" \
        "scikit-learn>=1.9.0" "polars>=1.42.1" numpy joblib

# Code applicatif + artefacts d'inférence (les gros modèles sont exclus via .dockerignore)
COPY ml/ ./ml/
COPY backend/ ./backend/
COPY models/scaler.joblib models/lstm_classifier.pt models/lstm_regressor.pt ./models/

EXPOSE 8000
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
